+/// Positioned read that does not disturb the file cursor, on both platforms.
+///
+/// Unix has `FileExt::read_exact_at`. Windows only offers `seek_read`, a single
+/// positioned read that is allowed to come up short, so it has to be driven to
+/// completion by hand.
+fn read_exact_at(file: &File, buf: &mut [u8], offset: u64) -> std::io::Result<()> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::FileExt;
+        file.read_exact_at(buf, offset)
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::FileExt;
+
+        let mut remaining = buf;
+        let mut position = offset;
+        while !remaining.is_empty() {
+            match file.seek_read(remaining, position) {
+                Ok(0) => {
+                    return Err(std::io::Error::new(
+                        std::io::ErrorKind::UnexpectedEof,
+                        "failed to fill whole buffer",
+                    ))
+                }
+                Ok(read) => {
+                    remaining = &mut remaining[read..];
+                    position += read as u64;
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(error) => return Err(error),
+            }
+        }
+        Ok(())
+    }
+}
