+/// Opens an artifact with every symbol bound at load. A lazily bound artifact
+/// resolves each builtin on its first call, and glibc records that dependency
+/// under the global load lock; with tens of thousands of artifacts and
+/// hundreds of executing threads that serialises the process on the lock.
+pub(crate) unsafe fn open_artifact(path: &std::path::Path) -> Result<libloading::Library, libloading::Error> {
+    #[cfg(unix)]
+    {
+        libloading::os::unix::Library::open(
+            Some(path),
+            libloading::os::unix::RTLD_NOW | libloading::os::unix::RTLD_LOCAL,
+        )
+        .map(libloading::Library::from)
+    }
+    #[cfg(not(unix))]
+    {
+        libloading::Library::new(path)
+    }
+}
